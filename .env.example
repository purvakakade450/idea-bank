# ---- Required for AI features (problem finding, ideas, scoring) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- News source (free key at https://newsdata.io) ----
NEWSDATA_API_KEY=
NEWSDATA_COUNTRY=in
NEWSDATA_CATEGORIES=business,technology,environment,health,science

# ---- Optional: Reddit app credentials (https://www.reddit.com/prefs/apps, type "script") ----
# Without these the app tries Reddit's public JSON, which Reddit may block.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_SUBREDDITS=india,indianstartups,developersIndia,IndianFarmers,mumbai,bangalore

# ---- Sources on/off (no keys needed for GDELT and Google Trends) ----
ENABLE_NEWSDATA=true
ENABLE_GDELT=true
ENABLE_GNEWS=true
ENABLE_TRENDS=true
ENABLE_REDDIT=true
TRENDS_GEO=IN

# ---- Engine ----
INGEST_INTERVAL_HOURS=4
MAX_SIGNALS_PER_RUN=60
MAX_IDEAS_PER_RUN=6
MIN_EVIDENCE=1
# true = AI ideas that pass all 4 rules go live without admin review (good for demos)
AUTO_APPROVE=false

# ---- App ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_TOKEN=change-me-to-a-long-random-string
DATABASE_PATH=data/ideabank.db
SECRET_KEY=change-me
PORT=8000

# ---- Email (so reviewers get their sign-in code and "ideas waiting" notices) ----
# Gmail: host smtp.gmail.com, port 587, user = your address, password = a Google "App password"
PUBLIC_URL=http://localhost:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
